{
  "manifest_version": 3,
  "name": "BWJM Interactive Document Viewer",
  "version": "0.1.0",
  "description": "Visualizador nativo para documentos matematicos interactivos .bwjm y .jm con graficas 2D/3D y animaciones.",
  "permissions": [
    "activeTab"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "file://*/*.bwjm",
        "file://*/*.jm",
        "file://*/*.BWJM",
        "file://*/*.JM"
      ],
      "js": [
        "dist/viewer.bundle.js",
        "content.js"
      ],
      "css": [
        "media/preview.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "BWJM Document Viewer"
  }
}
